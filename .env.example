# No .env file is needed: these are the defaults, and they match docker-compose.yml.
# Server code reads real environment variables only (this file is not loaded),
# so set one in your shell to override a default, e.g.:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/finder_test npm run db:migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5433/finder
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/finder_test
LOG_LEVEL=info
